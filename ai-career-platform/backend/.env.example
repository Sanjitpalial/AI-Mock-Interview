# Copy to .env and fill in values.

DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/ai_career_db

SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google AI Studio: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-google-ai-studio-key-here

GEMINI_MODEL=gemini-2.5-flash

CHROMA_PERSIST_DIR=./chroma_db

# LangSmith (optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=ai-career-platform

# Study Assistant (Groq) — not used by Mock Interview
# Required for Study Assistant (chat, notes, quiz, flashcards). Get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_MODEL=llama-3.1-8b-instant
CHROMA_STUDY_DIR=./chroma_study_db
# SAS_HOST=localhost
# SAS_PORT=5432
# SAS_USER=postgres
# SAS_PASSWORD=
# SAS_DATABASE=ai_career_db
